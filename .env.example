# Faqat namuna: lokal PostgreSQL uchun alohida app/test bazalar yarating.
DATABASE_URL="postgresql://edupay:change_me@localhost:5432/edupay"
TEST_DATABASE_URL="postgresql://edupay:change_me@localhost:5432/edupay_test"

# Compose: db servis nomi; haqiqiy parolni lokal .env ichida almashtiring.
POSTGRES_USER="edupay"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="edupay"
COMPOSE_DATABASE_URL="postgresql://edupay:change_me@db:5432/edupay"
